[Unit]
Description=Wolfram — proactive memory compression daemon
Documentation=https://github.com/wolfsoftwaresystemsltd/wolfram
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wolfram
Nice=19
IOSchedulingClass=idle
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
StartLimitBurst=5
StartLimitIntervalSec=120

# Wolfram needs root for /proc/[pid]/pagemap, page_idle bitmap,
# and process_madvise(). Runs as root intentionally.
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/wolfram

[Install]
WantedBy=multi-user.target
