[Unit]
Description=Wolfram — proactive memory compression daemon
Documentation=https://github.com/wolfsoftwaresystemsltd/wolfram
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
ExecStart=/usr/local/bin/wolfram
# Put back every kernel value Wolfram changed (swappiness, vfs_cache_pressure,
# compaction, watermark boost, KSM, zswap) even if the daemon crashed or was
# killed before its own shutdown path ran. No-op if nothing is recorded.
ExecStopPost=/usr/local/bin/wolfram --restore-tuning
Nice=19
IOSchedulingClass=idle
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

# Wolfram needs root for /proc/[pid]/pagemap, page_idle bitmap,
# and process_madvise(). Runs as root intentionally.
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/wolfram

[Install]
WantedBy=multi-user.target
